{
  "expo": {
    "name": "Rock ID",
    "slug": "rock-id",
    "version": "0.30.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rockid",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4efe7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.rock-id",
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f4efe7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.rockid",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98d5f682-6859-474c-bd6a-999f3ecf646e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/98d5f682-6859-474c-bd6a-999f3ecf646e"
    }
  }
}
