#!/usr/bin/env sh
set -e

branch="$(git branch --show-current 2>/dev/null || true)"
if [ "$branch" != "main" ]; then
  exit 0
fi

case "${GIT_REFLOG_ACTION-}" in
  pull*)
    exit 0
    ;;
esac

merged_branch=""
case "${GIT_REFLOG_ACTION-}" in
  merge\ *)
    merged_branch="${GIT_REFLOG_ACTION#merge }"
    ;;
esac

git_dir="$(git rev-parse --git-dir)"
premerge_head_file="$git_dir/husky-premerge-head"

premerge_head=""
if [ -f "$premerge_head_file" ]; then
  premerge_head="$(cat "$premerge_head_file")"
  rm -f "$premerge_head_file"
fi
if [ -z "$premerge_head" ]; then
  premerge_head="$(git rev-parse --verify ORIG_HEAD 2>/dev/null || true)"
fi
if [ -z "$premerge_head" ]; then
  exit 0
fi

tags_before="$(git tag)"

if ! pnpm -s test:e2e; then
  git reset --hard "$premerge_head"
  exit 1
fi

case "$merged_branch" in
  sprint/*|sprint-*)
    if pnpm -s bump; then
      exit 0
    fi
    ;;
  *)
    exit 0
    ;;
esac

tags_after="$(git tag)"
for tag in $tags_after; do
  printf '%s\n' "$tags_before" | grep -qx "$tag" && continue
  git tag -d "$tag" >/dev/null 2>&1 || true
done

git reset --hard "$premerge_head"
exit 1
