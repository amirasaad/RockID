{
  "name": "rock-id",
  "main": "expo-router/entry",
  "version": "0.7.1",
  "engines": {
    "node": ">=23 <24"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "commit": "cz",
    "prepare": "husky",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/photo-input.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "bump": "commit-and-tag-version",
    "bump:dry": "commit-and-tag-version --dry-run",
    "bump:patch": "commit-and-tag-version --release-as patch",
    "bump:minor": "commit-and-tag-version --release-as minor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-picker": "^17.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.1.0",
    "commit-and-tag-version": "^12.7.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-gitmoji-config": "^1.5.2",
    "cz-conventional-commit-gitmoji": "^1.3.0",
    "husky": "^9.1.7",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-commit-gitmoji"
    }
  },
  "private": true
}
