{
  "name": "rock-id",
  "main": "expo-router/entry",
  "version": "0.30.1",
  "engines": {
    "node": ">=23 <24"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "node scripts/run-android-with-jdk.mjs",
    "ios": "expo run:ios",
    "commit": "cz",
    "prepare": "husky",
    "postinstall": "node scripts/fix-native-deps.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/photo-input.test.ts",
    "test:e2e": "node -e \"require('fs').mkdirSync('playwright-report',{recursive:true})\" && playwright test",
    "test:e2e:install": "playwright install",
    "clip:index:demo": "node scripts/generate-clip-index.mjs --manifest data/clip/demo-manifest.json --out data/clip/demo-index.json",
    "clip:index:bytes": "node scripts/generate-clip-index.mjs --manifest data/clip/bytes-demo-manifest.json --out data/clip/bytes-demo-index.json --embedder bytes",
    "bump": "commit-and-tag-version",
    "bump:dry": "commit-and-tag-version --dry-run",
    "bump:patch": "commit-and-tag-version --release-as patch",
    "bump:minor": "commit-and-tag-version --release-as minor",
    "android:expo": "expo run:android",
    "bundle:ios": "expo export --platform ios --output-dir /private/tmp/rockid-ios-export",
    "bundle:android": "expo export --platform android --output-dir /private/tmp/rockid-android-export",
    "build:ios": "expo run:ios --no-install --no-bundler",
    "build:android": "node scripts/run-android-with-jdk.mjs --no-install --no-bundler",
    "verify:release-builds": "node scripts/verify-release-builds.mjs",
    "verify:detection-gates": "vitest run __tests__/s32-detection-gate-hardening.acceptance.test.ts __tests__/s32-non-rock-gate-fixture-shape.test.ts",
    "verify:failure-clusters": "vitest run __tests__/s33-failure-cluster-selection.test.ts __tests__/s33-cluster-brief-format.test.ts __tests__/s33-failure-cluster-brief.acceptance.test.ts __tests__/s33-failure-cluster-brief-cli.acceptance.test.ts __tests__/s33-fixture-slice-generator.test.ts",
    "brief:failure-clusters": "node scripts/print-failure-cluster-brief.mjs",
    "verify:calibration-stability": "vitest run __tests__/s34-calibration-stability.test.ts __tests__/s34-confidence-boundary-policy.acceptance.test.ts",
    "verify:expanded-eval": "vitest run __tests__/s24-detection-fixture-expansion.acceptance.test.ts __tests__/s25-field-qa.acceptance.test.ts __tests__/s26-confidence-calibration.acceptance.test.ts __tests__/s26-non-rock-hardening.acceptance.test.ts __tests__/s30-non-rock-confuser-expansion.acceptance.test.ts __tests__/s32-detection-gate-hardening.acceptance.test.ts __tests__/s33-failure-cluster-brief.acceptance.test.ts __tests__/s34-calibration-stability.test.ts __tests__/s34-confidence-boundary-policy.acceptance.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/codegen": "0.81.5",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "^17.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.10",
    "promise": "8.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "commit-and-tag-version": "^12.7.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-gitmoji-config": "^1.5.2",
    "cz-conventional-commit-gitmoji": "^1.3.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "config": {
    "commitizen": {
      "path": "./scripts/rockid-commitizen.cjs"
    }
  },
  "pnpm": {
    "overrides": {
      "@react-native/codegen": "0.81.5",
      "promise": "8.3.0"
    },
    "patchedDependencies": {
      "expo-dev-launcher@6.0.21": "patches/expo-dev-launcher@6.0.21.patch"
    }
  },
  "private": true,
  "commit-and-tag-version": {
    "releaseCommitMessageFormat": "🔖 bump(release): {{currentTag}}"
  }
}
